{
  "name": "markdown-office",
  "productName": "Markdown Office",
  "version": "26.10.0-dev.4",
  "description": "Calm Markdown editor with a bundled Markdown-to-PDF/A pipeline; the editor looks like the PDF while you type.",
  "license": "MIT",
  "author": "jcmx9",
  "homepage": "https://github.com/jcmx9/MarkdownOffice",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcmx9/MarkdownOffice.git"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "assets": "node scripts/fetch-pipeline-assets.mjs && node scripts/dev-layout.mjs",
    "dist": "node scripts/fetch-pipeline-assets.mjs && electron-vite build && electron-builder --publish never",
    "start": "electron-vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "electron-vite build && playwright test",
    "postinstall": "node scripts/dev-app-name.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@electron/osx-sign": "^1.3.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.1",
    "js-yaml": "^5.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3"
  }
}
