# Keep LF in the repository and in every checkout (Biome expects LF; Windows runners default to CRLF).
* text=auto eol=lf

# Shell scripts must be LF (shebang breaks otherwise)
*.sh    text eol=lf

# PowerShell scripts: CRLF in the working tree (Windows)
*.ps1   text eol=crlf

*.typ   text eol=lf
*.md    text eol=lf
*.svg   text eol=lf

# Binaries
*.png   binary
*.jpg   binary
*.pdf   binary
*.ttf   binary
*.otf   binary
*.woff2 binary
